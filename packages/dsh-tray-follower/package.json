{
  "name": "dsh-tray-follower",
  "version": "0.2.3",
  "description": "Per-workspace DSH conversation status in the Windows system tray, native DeepSeek Harness notifications, and a live Tray follower settings page.",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh-plugin",
    "dsh-bundle",
    "tray",
    "notification",
    "windows",
    "settings"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "author": "Green233233",
  "homepage": "https://github.com/Green233233/dsh_tray_follower#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Green233233/dsh_tray_follower.git"
  },
  "bugs": {
    "url": "https://github.com/Green233233/dsh_tray_follower/issues"
  }
}
